---
import { getCollection } from "astro:content";
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
import LayoutHelado from "../../layouts/LayoutHelado.astro";
export async function getStaticPaths() {
  const helados = await getCollection("helados");

  return helados.map((helado) => ({
    params: { id: helado.slug },
    props: { helado },
  }));
}

const { helado } = Astro.props;
const { data, slug } = helado;
const {
  nombre,
  categoria,
  thumbnail,
  img,
  opinionProfesional,
  InformacionNutricional,
  precio,
} = data;
---

<LayoutHelado
  bgClass="bg-gradient-to-b from-[#f8a4aa] to-[#F9C9FF]"
  title={`${nombre} - SAZÚ`}
  loading="eager"
>
  <section
    class="bg-gradient-to-b from-[#f8a4aa] to-[#F9C9FF] max-w-8xl min-h-screen lg:min-h-[90vh] py-6 px-6 md:px-10 flex justify-center items-center mt-20"
  >
    <div
      class="relative bg-white rounded-2xl shadow-xl p-6 md:p-10 lg:max-h-[80vh] max-w-3xl w-full flex flex-col lg:flex-row gap-10 justify-center"
    >
      <a
        href="/#catalogo"
        class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 text-3xl font-bold"
        title="Cerrar"
        id="btnCerrar"
      >
        &times;
      </a>

      <div class="flex justify-center lg:w-1/3 h-4/5">
        <Image
          src={img}
          alt="Imagen Helado"
          width={200}
          height={500}
          class="rounded-xl h-1/2 w-44 md:h-4/5 md:w-52 transition-opacity duration-500"
          transition:name={`img-${slug}`}
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="w-full lg:w-[60%] space-y-4">
        <div class="space-y-2">
          <h2 class="text-lg font-semibold">¿Para quién es?</h2>
          <p class="text-gray-600">
            Ideal para los que aman el sabor de {categoria}.
          </p>
        </div>

        <div class="space-y-2">
          <h2 class="text-lg font-semibold">Lo que dicen los profesionales</h2>
          <p class="text-gray-600 whitespace-pre-line">{opinionProfesional}</p>
        </div>
        <p class="border-t"></p>
        <p class="text-xl font-bold text-[#9810fa]">Precio: {precio}</p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            href="/#mapa"
            class="bg-[#9810fa] text-white px-5 py-3 rounded-lg text-lg font-semibold hover:bg-[#b156f1] transition cursor-pointer text-center"
            onclick="
           
            window.isNavigatingBack = false;
            
           
            if (window.astro && window.astro.navigate) {
              event.preventDefault();
              window.astro.navigate('/#mapa');
              return false;
            }
            
            
          "
          >
            ¿Dónde Comprar?
          </a>

          <button
            id="btnFicha"
            onclick="
              
              if (window.innerWidth < 768) {
                const panel = document.getElementById('fichaMovil');
                const btn = document.getElementById('btnFicha');
                const isOpen = panel.classList.toggle('hidden') === false;
                btn.classList.toggle('bg-green-500', isOpen);
                btn.classList.toggle('text-white', isOpen);
                btn.classList.toggle('hover:bg-gray-100', !isOpen);
                btn.classList.toggle('border-transparent', isOpen);
                btn.textContent = isOpen ? 'Ocultar ficha nutricional' : 'Ver ficha nutricional';
                if (isOpen) {
                  setTimeout(() => {
                    panel.scrollIntoView({ behavior: 'smooth', block: 'start' });
                  }, 100);
                }
              } else {
                
                const panel = document.getElementById('sidebarNutricional');
                const btn = document.getElementById('btnFicha');
                const isOpen = panel.classList.toggle('translate-x-full') === false;
                panel.classList.toggle('translate-x-0', isOpen);
                btn.classList.toggle('bg-green-500', isOpen);
                btn.classList.toggle('text-white', isOpen);
                btn.classList.toggle('hover:bg-gray-100', !isOpen);
                btn.classList.toggle('border-transparent', isOpen);
                btn.textContent = isOpen ? 'Ocultar ficha' : 'Ver ficha nutricional';
              }
            "
            class="border border-gray-500 text-gray-700 px-6 py-3 rounded-lg text-lg font-semibold hover:bg-gray-100 transition"
          >
            Ver ficha nutricional
          </button>
        </div>

        <div class="border-t pt-4 mt-4">
          <h3 class="text-lg font-semibold mb-2">Garantías de SAZÚ</h3>
          <ul class="space-y-1 text-gray-600">
            <li>✔ Ingredientes 100% Naturales</li>
            <li>✔ Sin conservantes ni colorantes</li>
            <li>✔ Buena Calidad</li>
          </ul>
        </div>

        <div
          id="fichaMovil"
          class="hidden md:hidden mt-6 p-2 text-[#7b62fc] bg-gray-50 rounded-lg border border-indigo-200"
        >
          <h4
            class="text-lg font-bold text-[#7b62fc] font-['Graviola_Soft_Heavy']"
          >
            INFORMACIÓN NUTRICIONAL
          </h4>
          <hr class="my-1 border-3 border-[#bab0ff]" />
          <div class="text-sm">
            <p>
              <strong>Tamaño de Porción:</strong>
              {InformacionNutricional.tamanoPorcion} g
            </p>
            <p>
              <strong>Porciones por envase:</strong>
              {InformacionNutricional.porcionPorEnvase}
            </p>
            <hr class="my-1 border-2 border-[#bab0ff]" />
            <p>
              <strong>Energía Total:</strong>
              {InformacionNutricional.energiaTotal} KJ / {
                InformacionNutricional.calorias
              } kcal
            </p>

            <hr class="my-1 border-3 border-[#bab0ff]" />

            <p class="font-bold text-base font-['Graviola_Soft_Heavy']">
              % VALORES DIARIOS*
            </p>

            <hr class="my-0.5 border-2 border-[#bab0ff]" />

            <div class="space-y-1">
              <p>
                <strong>Grasa total:</strong>
                {InformacionNutricional.grasas} g
              </p>
              <p class="ml-4 text-xs text-[#836bfc]">
                Grasa Saturada: {InformacionNutricional.grasasSaturadas} g
              </p>
              <p class="ml-4 text-xs text-[#836bfc]">
                Trans: {InformacionNutricional.grasasTrans} g
              </p>

              <hr class="my-0.5 border-2 border-[#bab0ff]" />

              <p>
                <strong>Colesterol:</strong>
                {"<"}{InformacionNutricional.colesterol} mg
              </p>

              <hr class="my-0.5 border-2 border-[#bab0ff]" />

              <p>
                <strong>Sodio:</strong>
                {InformacionNutricional.sodio ?? "0"} mg
              </p>

              <hr class="my-0.5 border-2 border-[#bab0ff]" />

              <p>
                <strong>Carbohidratos:</strong>
                {InformacionNutricional.carbohidratos} g
              </p>

              <hr class="my-0.5 border-2 border-[#bab0ff]" />

              <p class="ml-4 text-xs text-[#836bfc]">
                Fibra dietética: {InformacionNutricional.fibraDietetica} g
              </p>
              <p class="ml-4 text-xs text-[#836bfc]">
                Azúcar: {InformacionNutricional.azucar} g
              </p>
              <hr class="my-0.5 border-2 border-[#bab0ff]" />
              <p>
                <strong>Proteína:</strong>
                {InformacionNutricional.proteinas} g
              </p>
            </div>

            <hr class="my-1 border-2 border-[#bab0ff]" />

            <p class="text-xs text-[#836bfc] mt-3">
              *Los Porcentajes de Valores Diarios están basados en una dieta de
              2000 calorías, según FDA. Sus valores diarios pueden ser mayores o
              menores dependiendo de las necesidades calóricas.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Sidebar nutricional para desktop - se mantiene igual -->
  <div
    id="sidebarNutricional"
    class="hidden md:block bg-white fixed top-1/5 right-0 w-80 text-[#7b62fc] shadow-lg p-5 transition transform translate-x-full z-50 rounded-l-xl overflow-auto max-h-[85vh] border border-indigo-200"
  >
    <button
      onclick="
      const panel1 = document.getElementById('sidebarNutricional');
      const btn1 = document.getElementById('btnFicha');

      panel1.classList.add('translate-x-full'); 
      panel1.classList.remove('translate-x-0'); 

      btn1.classList.remove('bg-green-500', 'text-white', 'border-transparent');
      btn1.classList.add('hover:bg-gray-100');
    "
      class="absolute top-2 right-3 text-gray-500 hover:text-gray-800 text-2xl font-bold"
    >
      &times;
    </button>

    <h4 class="text-xl font-['Graviola_Soft_Heavy'] mb-2">
      INFORMACIÓN NUTRICIONAL
    </h4>
    <hr class="my-2 border-3 border-[#bab0ff]" />
    <div class="text-lg">
      <p>
        <strong>Tamaño de Porción:</strong>
        {InformacionNutricional.tamanoPorcion} g
      </p>
      <p>
        <strong>Porciones por envase:</strong>
        {InformacionNutricional.porcionPorEnvase}
      </p>
      <hr class="my-2 border-2 border-[#bab0ff]" />
      <p>
        <strong>Energía Total:</strong>
        {InformacionNutricional.energiaTotal} KJ / {
          InformacionNutricional.calorias
        } kcal
      </p>

      <hr class="my-2 border-3 border-[#bab0ff]" />

      <p class="font-['Graviola_Soft_Heavy'] text-xl mb-1">
        % VALORES DIARIOS*
      </p>

      <hr class="border-2 border-[#bab0ff]" />

      <ul class="list-none text-base">
        <li><strong>Grasa total:</strong> {InformacionNutricional.grasas} g</li>
        <li class="ml-4 text-base text-[#836bfc]">
          Grasa Saturada: {InformacionNutricional.grasasSaturadas} g
        </li>
        <li class="ml-4 text-base text-[#836bfc]">
          Trans: {InformacionNutricional.grasasTrans} g
        </li>

        <hr class="my-0.5 border-2 border-[#bab0ff]" />

        <li>
          <strong>Colesterol:</strong>
          {"<"}{InformacionNutricional.colesterol} mg
        </li>

        <hr class="my-0.5 border-2 border-[#bab0ff]" />

        <li>
          <strong>Sodio:</strong>
          {InformacionNutricional.sodio ?? "0"} mg
        </li>

        <hr class="my-0.5 border-2 border-[#bab0ff]" />

        <li>
          <strong>Carbohidratos:</strong>
          {InformacionNutricional.carbohidratos} g
        </li>

        <hr class="my-0.5 border-2 border-[#bab0ff]" />

        <li class="ml-4 text-base text-[#836bfc]">
          Fibra dietética: {InformacionNutricional.fibraDietetica} g
        </li>
        <li class="ml-4 text-base text-[#836bfc]">
          Azúcar: {InformacionNutricional.azucar} g
        </li>
        <hr class="my-0.5 border-2 border-[#bab0ff]" />
        <li><strong>Proteína:</strong> {InformacionNutricional.proteinas} g</li>
      </ul>

      <hr class="my-0.5 border-2 border-[#bab0ff]" />

      <p class="text-sm text-[#836bfc] mt-2">
        *Los Porcentajes de Valores Diarios están basados en una dieta de 2000
        calorías, según FDA. Sus valores diarios pueden ser mayores o menores
        dependiendo de las necesidades calóricas.
      </p>
    </div>
  </div>
</LayoutHelado>
