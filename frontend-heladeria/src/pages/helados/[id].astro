---
import { getCollection } from "astro:content";
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const helados = await getCollection("helados");

  return helados.map((helado) => ({
    params: { id: helado.slug },
    props: { helado },
  }));
}

const { helado } = Astro.props;
const { data, slug } = helado;
const {
  nombre,
  categoria,
  thumbnail,
  img,
  opinionProfesional,
  InformacionNutricional,
  precio,
} = data;
---

<Layout title={`${nombre} - SAZÚ`}>
  <div
    class="bg-[#FFF7EC] min-h-screen flex justify-center items-start py-16 px-4"
  >
    <div class="relative bg-white rounded-2xl shadow-xl max-w-lg px-4 py-4">
      <!-- Botón cerrar -->
      <a
        href="/"
        class="absolute top-4 right-4 text-2xl font-bold text-gray-400 hover:text-gray-700"
        >×</a
      >

      <!-- Título centrado -->
      <h1 class="text-4xl font-bold text-center mb-4">{nombre}</h1>
      <div class="flex flex-col md:flex-row gap-5">
        
        <div class="flex flex-col items-center w-full md:w-60">
          <img
            src={img}
            alt={nombre}
            class="rounded-xl w-40 h-82 object-cover mb-4"
          />
          <h2 class="text-2xl font-medium mb-2">Ficha Nutricional</h2>
          <ul
            class="text-left text-base ml-6 font-semibold text-[#7174ff] space-y-1"
          >
            <li>
              <span class="font-bold">Tamaño Porción:</span>
              {InformacionNutricional.tamanoPorcion}
            </li>
            <li>
              <span class="font-bold">Porción por envase:</span>
              {InformacionNutricional.porcionPorEnvase}
            </li>
            <li>
              <span class="font-bold">Energía Total:</span>
              {InformacionNutricional.energiaTotal}
            </li>
            <li>
              <span class="font-bold">Calorías:</span>
              {InformacionNutricional.calorias}
            </li>
            <li>
              <span class="font-bold">Grasas:</span>
              {InformacionNutricional.grasas}
            </li>
            <li>
              <span class="font-bold">Azúcar:</span>
              {InformacionNutricional.azucar}
            </li>
            <li>
              <span class="font-bold">Proteínas:</span>
              {InformacionNutricional.proteinas}
            </li>
            <li>
              <span class="font-bold">Sodio:</span>
              {InformacionNutricional.sodio}
            </li>
            <li>
              <span class="font-bold">Colesterol:</span>
              {InformacionNutricional.colesterol}
            </li>
            <li>
              <span class="font-bold">Carbohidratos:</span>
              {InformacionNutricional.carbohidratos}
            </li>
          </ul>
        </div>

        <!-- Columna derecha: info del producto -->
        <div class="flex-1">
          <div class="mb-6">
            <h3 class="text-lg font-semibold text-gray-700 mb-1">
              ¿Para quién es?
            </h3>
            <p class="text-gray-600">
              Ideal para los que aman el sabor de {categoria}.
            </p>
          </div>

          <div class="mb-6">
            <h3 class="text-lg font-semibold text-gray-700 mb-1">
              Lo que dicen los profesionales
            </h3>
            <p class="text-gray-600 whitespace-pre-line">
              {opinionProfesional}
            </p>
          </div>

          <div class="mt-8 text-center">
            <p class="text-xl font-bold text-[#7174ff]">Precio: ₡{precio}</p>
          </div>
        </div>
      </div>
    </div>
  </div>
</Layout>
