---
import { getCollection } from "astro:content";
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";
import { Image } from "astro:assets";
export async function getStaticPaths() {
  const helados = await getCollection("helados");

  return helados.map((helado) => ({
    params: { id: helado.slug },
    props: { helado },
  }));
}

const { helado } = Astro.props;
const { data, slug } = helado;
const {
  nombre,
  categoria,
  thumbnail,
  img,
  opinionProfesional,
  InformacionNutricional,
  precio,
} = data;
---

<Layout bgClass="bg-[#FFF7EC]" title={`${nombre} - SAZÚ`} loading="eager">
  <section 
    class="bg-[#FFF7EC] max-w-8xl min-h-screen lg:min-h-[90vh] py-6 px-4 md:px-10 flex justify-center items-center mt-4"
  >
    <div
      class="relative bg-white rounded-2xl shadow-xl p-6 md:p-10 lg:max-h-[80vh] max-w-3xl w-full flex flex-col lg:flex-row gap-10 justify-center"
    >
      <a
        href={`/#catalogo-${slug}`}
        class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 text-3xl font-bold"
        title="Cerrar"
      >
        &times;
      </a>

      <div class="flex justify-center lg:w-1/3 h-4/5">
        <Image
          src={img}
          alt="Imagen Helado"
          width={230}
          height={570}
          class="rounded-xl h-4/5 w-52 transition-opacity duration-500"
          transition:name={`img-${slug}`}
          loading="eager"
          decoding="async"
        />
      </div>

      <div class="w-full lg:w-[60%] xl:max-w-[500px] space-y-6">
        <div class="space-y-2">
          <h2 class="text-lg font-semibold">¿Para quién es?</h2>
          <p class="text-gray-600">
            Ideal para los que aman el sabor de {categoria}.
          </p>
        </div>

        <div class="space-y-2">
          <h2 class="text-lg font-semibold">Lo que dicen los profesionales</h2>
          <p class="text-gray-600 whitespace-pre-line">{opinionProfesional}</p>
        </div>
        <p class="border-t"></p>
        <p class="text-xl font-bold text-[#9810fa]">Precio: {precio}</p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            class="bg-[#9810fa] text-white px-6 py-3 rounded-lg text-lg font-semibold hover:bg-[#5a5ee0] transition cursor-pointer"
          >
            Comprar ahora
          </a>

          <button
            id="btnFicha"
            onclick="
                      const panel = document.getElementById('sidebarNutricional');
                      const btn = document.getElementById('btnFicha');
                      const isOpen = panel.classList.toggle('translate-x-full') === false;
                      panel.classList.toggle('translate-x-0', isOpen);
                      btn.classList.toggle('bg-green-500', isOpen);
                      btn.classList.toggle('text-white', isOpen);
                      btn.classList.toggle('hover:bg-gray-100', !isOpen);
                      btn.classList.toggle('border-transparent', isOpen);
                    "
            class="border border-gray-500 text-gray-700 px-6 py-3 rounded-lg text-lg font-semibold hover:bg-gray-100 transition"
          >
            Ver ficha nutricional
          </button>
        </div>

        <div class="border-t pt-4 mt-4">
          <h3 class="text-lg font-semibold mb-2">Garantías de SAZÚ</h3>
          <ul class="space-y-1 text-gray-600">
            <li>✔ Ingredientes 100% Naturales</li>
            <li>✔ Sin conservantes ni colorantes</li>
            <li>✔ Entrega rápida</li>
          </ul>
        </div>
      </div>
    </div>
  </div>

  <div
    id="sidebarNutricional"
    class="bg-indigo-500 fixed top-1/3 right-0 w-72 text-white shadow-lg p-5 transition transform translate-x-full z-50 rounded-l-xl overflow-auto max-h-[60vh]"
  >
    <button
      onclick="document.getElementById('sidebarNutricional').classList.add('translate-x-full')"
      class="absolute top-2 right-3 text-gray-500 hover:text-gray-800 text-xl font-bold"
    >
      &times;
    </button>

    <h4 class="text-lg font-semibold mb-3">Información Nutricional</h4>

    <ul class="list-disc list-inside space-y-1 text-base">
      <li>Carbohidratos: {InformacionNutricional.carbohidratos}</li>
      <li>Proteínas: {InformacionNutricional.proteinas}</li>
      <li>Grasas: {InformacionNutricional.grasas}</li>
      <li>Azúcares: {InformacionNutricional.azucar}</li>
    </ul>
  </div>
</Layout>
