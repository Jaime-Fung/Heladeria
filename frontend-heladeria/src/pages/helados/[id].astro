---
import { getCollection } from "astro:content";
import "../../styles/global.css";
import Layout from "../../layouts/Layout.astro";

export async function getStaticPaths() {
  const helados = await getCollection("helados");

  return helados.map((helado) => ({
    params: { id: helado.slug },
    props: { helado },
  }));
}

const { helado } = Astro.props;
const { data, slug } = helado;
const {
  nombre,
  categoria,
  thumbnail,
  img,
  opinionProfesional,
  InformacionNutricional,
  precio,
} = data;
---

<Layout title={`${nombre} - SAZÚ`}>
  <div
    class="bg-[#FFF7EC] min-h-screen lg:min-h-[90vh] py-6 px-4 md:px-10 flex justify-center items-center mt-4"
  >
    <div
      class="relative bg-white rounded-2xl shadow-xl p-6 md:p-10 lg:max-h-[90vh] max-w-4xl w-full flex flex-col lg:flex-row gap-10 justify-center"
    >
      <a
        href="/#catalogo"
        class="absolute top-4 right-4 text-gray-400 hover:text-gray-700 text-3xl font-bold"
        title="Cerrar"
      >
        &times;
      </a>
      <div class="flex justify-center lg:w-1/3">
        <img src={img} class="rounded-xl w-52 md:w-80 lg:w-72 xl:w-80" />
      </div>

      <div class="w-full lg:w-[60%] xl:max-w-[500px] space-y-6">
        <div class="space-y-2">
          <h2 class="text-lg font-semibold text-gray-700">¿Para quién es?</h2>
          <p class="text-gray-600">
            Ideal para los que aman el sabor de {categoria}.
          </p>
        </div>

        <div class="space-y-2">
          <h2 class="text-lg font-semibold text-gray-700">
            Lo que dicen los profesionales
          </h2>
          <p class="text-gray-600 whitespace-pre-line">{opinionProfesional}</p>
        </div>
        <p class="border-t"></p>
        <p class="text-xl font-medium text-[#7174ff]">Precio: ₡{precio}</p>

        <div class="flex flex-col sm:flex-row gap-4">
          <a
            class="bg-[#7174ff] text-white px-6 py-3 rounded-lg text-lg font-semibold hover:bg-[#5a5ee0] transition cursor-pointer"
          >
            Comprar ahora
          </a>
          <button
            onclick="document.getElementById('fichaNutricional').classList.toggle('hidden')"
            class="border border-gray-500 text-gray-700 px-6 py-3 rounded-lg text-lg font-semibold hover:bg-gray-100 transition"
          >
            Ver ficha nutricional
          </button>
        </div>

        <div class="border-t pt-4 mt-4">
          <h3 class="text-lg font-semibold mb-2">Garantías de SAZÚ</h3>
          <ul class="space-y-1 text-gray-600">
            <li>✔ Ingredientes 100% Naturales</li>
            <li>✔ Sin conservantes ni colorantes</li>
            <li>✔ Entrega rápida</li>
          </ul>
        </div>
      </div>
      <div
        id="fichaNutricional"
        class="hidden border p-4 rounded-lg bg-gray-50 text-sm text-gray-700"
      >
        <h4 class="font-bold mb-2">Información Nutricional (por porción)</h4>
        <ul class="list-disc list-inside space-y-1">
          <li>Carbohidratos: {InformacionNutricional.carbohidratos}</li>
          <li>Proteínas: {InformacionNutricional.proteinas}</li>
          <li>Grasas: {InformacionNutricional.grasas}</li>
          <li>Azúcares: {InformacionNutricional.azucar}</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>


