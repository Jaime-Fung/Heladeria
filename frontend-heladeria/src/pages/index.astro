---
import Layout from "../layouts/Layout.astro";
import HeroSection from "../components/Landing Page/HeroSection.astro";
import SobreNosotros from "../components/Landing Page/Sobre-Nosotros.astro";
import "../styles/global.css";

import Contacto from "../components/Landing Page/Contacto.astro";
import Catalogo from "../components/Landing Page/Catalogo.astro";
import Sections from "../components/General/Sections.astro";
import FAQs from "../components/Ubicacion y FAQ/FAQs.astro";
import MapaUbicacion from "../components/Ubicacion_y_FAQ/MapaUbicacion";

---

<!--- Acá se coloca desde el "Hero" hasta la imagen de "¡Felicidad sin Remordimiento!" -->
<Layout>
  <Sections id="heroSection">
    <HeroSection />
  </Sections>

  <Sections id="sobreNosotros">
    <SobreNosotros />
  </Sections>

  <Sections id="catalogoo">
    <Catalogo />
  </Sections>

  <Sections id="mapa">
    <MapaUbicacion client:only="react" />
  </Sections>

  <Sections id="FAQ">
    <FAQs />
  </Sections>

  <Sections id="contacto">
    <Contacto />
  </Sections>
</Layout>
