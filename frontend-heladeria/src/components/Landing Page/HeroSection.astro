---
import coco from "../../assets/coco-organico-sabor.png";
import frutos from "../../assets/frutos-rojos-sabor.png";
import gomitas from "../../assets/ositos-de-goma-sabor.png";

const slides = [
  {
    title: "Frutos Rojos",
    desc: "Explosión de frutos rojos: fresa, mora y arándano en cada mordida antioxidante.",
    image: coco,
    alt: "Helado frutos rojos",
  },
  {
    title: "Coco Organico",
    desc: "Helado de yogurt descremado con coco orgánico y probióticos, ideal para cuidar tu digestión.",
    image: frutos,
    alt: "Helado coco orgánico",
  },
  {
    title: "Ositos de goma",
    desc: "Divertidos ositos de goma con colágeno hidrolizado y cero azúcar añadida.",
    image: gomitas,
    alt: "Helado ositos de goma",
  },
];
---

<section class="py-12">
  <div
    class="container mx-auto md:pl-20 px-6 max-w-7xl flex flex-col md:flex-row items-center gap-12"
  >
    <!-- Texto e indicadores -->
    <div class="w-full md:w-1/2 text-center md:text-left mb-8 md:mb-0">
      <h1 id="slide-title" class="text-4xl font-bold mb-4 text-teal-500">
        Helado sabor: {slides[0].title}
      </h1>
      <p id="slide-desc" class="text-gray-600 mb-6">
        {slides[0].desc}
      </p>
      <a
        href="/#catalogo"
        class="inline-block bg-gradient-to-br from-purple-500 to-pink-500 text-white font-medium px-6 py-3 rounded-full hover:bg-gradient-to-br hover:from-pink-500 hover:to-purple-500 transition"
      >
        Ir al catálogo
      </a>
      <div
        id="dots-container"
        class="flex justify-center md:justify-start space-x-2 mt-6"
      >
        {
          slides.map((slide, idx) => (
            <button
              data-dot
              data-index={idx}
              data-title={slide.title}
              data-desc={slide.desc}
              class="w-3 h-3 rounded-full bg-gray-300 transition-all duration-300 ease-in-out hover:bg-purple-500 hover:scale-125"
              aria-label={`Slide ${idx + 1}`}
            />
          ))
        }
      </div>
    </div>

    <!-- Carrusel de imágenes -->
    <div class="w-full md:w-1/2">
      <div
        class="relative w-full h-64 md:h-96"
      >
        {
          slides.map((slide, idx) => (
            <img
              src={slide.image.src}
              alt={slide.alt}
              data-slide
              class={`absolute inset-0 mx-auto md:ml-auto sm:mr-0 my-auto max-h-96 object-contain transition-opacity duration-500 ${idx === 0 ? "opacity-100" : "opacity-0"}`}
            />
          ))
        }
      </div>
    </div>
  </div>

  <script is:inline>
    let current = 0;
    const slidesEls = Array.from(document.querySelectorAll("[data-slide]"));
    const dots = Array.from(document.querySelectorAll("[data-dot]"));
    const titleEl = document.getElementById("slide-title");
    const descEl = document.getElementById("slide-desc");

    function showSlide(n) {
      current = n;
      slidesEls.forEach((el, idx) => {
        el.style.opacity = idx === n ? "1" : "0";
      });
      dots.forEach((dot, idx) => {
        dot.classList.toggle("bg-purple-500", idx === n);
        dot.classList.toggle("scale-125", idx === n);
      });
      titleEl.textContent = `Helado sabor: ${dots[n].dataset.title}`;
      descEl.textContent = dots[n].dataset.desc;
    }

    dots.forEach((dot) =>
      dot.addEventListener("click", () => showSlide(Number(dot.dataset.index)))
    );

    // Slide inicial
    showSlide(0);

    // Autoplay + pausa al hover
    let timer = setInterval(
      () => showSlide((current + 1) % slidesEls.length),
      5000
    );

    const dotsContainer = document.getElementById("dots-container");
    dotsContainer.addEventListener("mouseenter", () => clearInterval(timer));
    dotsContainer.addEventListener("mouseleave", () => {
      timer = setInterval(
        () => showSlide((current + 1) % slidesEls.length),
        5000
      );
    });
  </script>
</section>
