---
import { getCollection } from "astro:content";

const helados = await getCollection("helados");
---

<section class="bg-[#FFF7EC] py-8">
  <h2 class="text-5xl font-semibold text-center">Mira Nuestro Catálogo</h2>
  <p class="text-center text-xl font-medium max-w-2xl mx-auto mt-4">
    Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod
    tempor incididunt ut labore et dolore magna aliqua.
  </p>

  <div
    class="grid mt-5 grid-cols-2 sm:grid-cols-2 md:grid-cols-3 gap-x-6 gap-y-8 max-w-[900px] mx-auto px-4 items-stretch"
  >
    {
      helados.map((helado) => {
        const { data, slug } = helado;
        const {
          nombre,
          categoria,
          precio,
          thumbnail,
          opinionProfesional,
          datosNutricionales,
        } = data;

        return (
          <article class="bg-white p-4 rounded-xl shadow hover:shadow-lg transition flex h-full">
            <div class="flex flex-col justify-center h-full">
              <img
                transition:name={`thumbnail-${slug}`}
                class="w-24 h-24 mx-auto mb-4  object-cover"
                src={`${thumbnail}`}
                alt={nombre}
              />
              <h3 class="text-base sm:text-lg font-semibold text-center">
                {nombre}
              </h3>
              <p class="text-xs sm:text-sm text-gray-600 text-center my-0.5">
                Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do
                eiusmod tempor incididunt
              </p>
              <p class="text-center font-semibold text-gray-800 my-2">
                ₡{precio}
              </p>
              <div class="text-center mt-auto">
                <a
                  href={`/catalogo/${slug}`}
                  class="inline-block bg-[#FDCACA] hover:bg-[#EB9595] text-black px-3 sm:px-4 py-2 rounded-xl text-sm md:w-40 w-36"
                >
                  Ver más...
                </a>
              </div>
            </div>
          </article>
        );
      })
    }
  </div>
</section>
