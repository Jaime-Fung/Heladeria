---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
const helados = await getCollection("helados");
---
<section class="bg-gradient-to-b from-[#f8a4aa] to-[#F9C9FF] py-8">
  <h2 class="text-5xl font-semibold text-center pb-3.5 text-white">
    Mira Nuestro Catálogo
  </h2>
  <p class="text-center text-lg sm:text-xl font-medium max-w-2xl mx-auto mt-4 text-gray-700">
    Descubrí nuestra línea de helados saludables, elaborados con frutas reales y
    libres de conservantes.
  </p>

  <div
    class="grid mt-5 grid-cols-2 sm:grid-cols-2 md:grid-cols-3 gap-x-2 gap-y-4 max-w-[750px] mx-auto px-4 items-stretch"
  >
    {
      helados.map((helado, index) => {
        const { data, slug } = helado;
        const { nombre, descripcion, precio, thumbnail, img } = data;

        const isLast = index === helados.length - 1;
        const leavesOne = helados.length % 3 === 1;

        const isCenteredLast = isLast && leavesOne;
        const wrapperClass = isCenteredLast
          ? "md:col-span-3 sm:col-span-2 flex justify-center"
          : "";
        const articleClass = isCenteredLast
          ? "bg-white p-4 scroll-mt-28 rounded-xl shadow hover:shadow-lg transition flex h-full w-full max-w-[240px]"
          : "bg-white p-4 scroll-mt-28 rounded-xl shadow hover:shadow-lg transition flex h-full";

        return (
          <div class={wrapperClass}>
            <article class={articleClass} id={`catalogo-${slug}`}>
              <div class="flex flex-col justify-center h-full">
                <Image
                  transition:name={`img-${slug}`}
                  width={208}
                  height={208}
                  class="w-32 h-32 mx-auto mb-4 rounded-full object-cover transition"
                  src={thumbnail}
                  alt={nombre}
                  loading="lazy"
                />

                <h3 class="text-base sm:text-lg font-semibold text-center text-[#aa53e9]">
                  {nombre}
                </h3>
                <p class="text-xs sm:text-sm text-gray-600 text-center my-0.5">
                  {descripcion}
                </p>
                <div class="text-center mt-auto">
                  <p class="text-center font-semibold text-gray-800 my-2">
                    <span class="text-gray-600">₡</span>{precio}
                  </p>
                  <a
                    href={`/helados/${slug}`}
                    class="inline-block bg-gradient-to-r from-[#FF8A91] to-[#F28DFF] shadow hover:shadow-lg text-white px-3 sm:px-4 py-2 rounded-xl text-sm md:w-40 w-32 transition"
                  >
                    Ver más...
                  </a>
                </div>
              </div>
            </article>
          </div>
        );
      })
    }
  </div>

  <div class="flex flex-col items-center mt-7 gap-2.5">
    <p class="text-gray-700">Lorem ipsum dolor sit amet, consectetur adipiscing elit.</p>
    <a
      href="/#contacto"
      class="border-1 rounded-2xl px-8 py-1.5 bg-[#FF8A91] hover:bg-[#F28DFF] text-white transition"
    >
      Ir a Contacto
    </a>
  </div>
</section>

