---
import FacebookIcon from "../Icons/FacebookIcon.astro";
import InstagramIcon from "../Icons/InstagramIcon.astro";
import WhatsappIcon from "../Icons/WhatsappIcon.astro";
---

<section class="py-12 bg-gradient-to-b from-[#FDFEFE] to-orange-50 shadow-2xl">
  <div class="container max-w-6xl mx-auto px-4 flex flex-col md:flex-row items-center md:justify-between">
    <!-- Bloque principal -->
    <div class="md:w-2/3">
      <!-- Nombre -->
      <h1 class="text-4xl font-bold mb-2 text-purple-600">Sazú</h1>
      <!-- Título de sección -->
      <h2 class="text-2xl font-semibold mb-4 text-purple-400">Sobre Nosotros</h2>
      <!-- Texto descriptivo -->
      <p class="text-gray-700 mb-6">
        Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed do eiusmod
        tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
        veniam.
      </p>
      <!-- Botón y redes-->
      <div class="flex items-center space-x-6 mt-6">

        <!-- <button
          class="bg-gradient-to-r from-purple-400 to-pink-500 text-white px-5 py-2 rounded-full hover:opacity-80 transition"
        > Más información... </button> -->

        <!-- Redes sociales -->
        <div class="flex space-x-2">
          <a href="https://api.whatsapp.com/send?phone=50661234421&text=Hola!%20Quiero%20más%20información." aria-label="WhatsApp" class="transition-transform hover:scale-110 p-2.5 rounded-full bg-gradient-to-br  from-purple-500 to-pink-500">
            <WhatsappIcon fill="#C94ADD" />
          </a>
          <a href="https://www.facebook.com/hola.sazu" aria-label="Facebook" class="transition-transform hover:scale-110 p-2.5 rounded-full bg-gradient-to-br from-purple-500 to-pink-500">
            <FacebookIcon fill="#C94ADD" />
          </a>
          <a href="https://www.instagram.com/hola.sazu/" aria-label="Instagram" class="transition-transform hover:scale-110 p-2.5 rounded-full bg-gradient-to-br from-purple-500 to-pink-500">
            <InstagramIcon fill="#ffffff" />
          </a>
        </div>
      </div>
    </div>

    <!-- Círculo con experiencia -->
    <div class="md:w-1/3 flex justify-center md:justify-end mt-8 md:mt-0">
      <div
        class="bg-gradient-to-br from-purple-500 to-pink-500 text-white w-28 h-28 rounded-full flex flex-col items-center justify-center gap-1 text-center font-bold"
      >
        <span class="text-xl">+4 años</span>
        <span class="text-xl">Exp</span>
      </div>
    </div>
  </div>
</section>
