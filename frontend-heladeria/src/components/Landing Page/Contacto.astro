---
import felicidadImg from "../../assets/background-contacto.png";
import FacebookIcon from "../Icons/FacebookIcon.astro";
import InstagramIcon from "../Icons/InstagramIcon.astro";
import WhatsappIcon from "../Icons/WhatsappIcon.astro";
import Socials from "../General/Socials.astro";
import { Image } from "astro:assets";
---

<section class="relative pt-10">
  <!-- Fondo blob -->
  <img
    class="pointer-events-none absolute inset-0 w-full h-full object-cover opacity-25 bg-gradient-to-r from-gray-50 to-stone-200"
    loading="lazy"
    aria-hidden="true"
  />

  <div
    class="relative container mx-auto px-6 lg:px-16 grid grid-cols-1 md:grid-cols-2 gap-12"
  >
    <!-- IZQUIERDA: info de contacto -->
    <div class="space-y-6">
      <h2 class="text-4xl font-extrabold text-teal-500">Contacto</h2>
      <p class="text-gray-700 text-lg max-w-md">
        Si tienes alguna pregunta o deseas más información, no dudes en
        contactarnos. Estamos para ayudarte.
      </p>

      <div>
        <h3 class="font-semibold text-lg text-teal-500">Teléfono</h3>
        <p class="text-gray-800 text-lg">+506 6123‑4421</p>
      </div>

      <div>
        <h3 class="font-semibold text-lg text-teal-500">Correo</h3>
        <div class="flex items-center space-x-3">
          <p class="text-gray-800 text-lg">distribuidora@sazu.com</p>
        </div>
      </div>

      <div>
        <h3 class="font-semibold text-lg text-teal-500 mb-2">Nuestras Redes Sociales</h3>

        <div class="flex space-x-2">
          <Socials
            href="https://api.whatsapp.com/send?phone=50661234421&text=Hola!%20Quiero%20más%20información."
            aria-label="WhatsApp"
            class="transition-transform hover:scale-110 p-2.5 rounded-full bg-gradient-to-br from-purple-500 to-pink-500"
          >
            <WhatsappIcon fill="#C94ADD" />
          </Socials>

          <Socials
            href="https://www.facebook.com/hola.sazu"
            aria-label="Facebook"
            class="transition-transform hover:scale-110 p-2.5 rounded-full bg-gradient-to-br from-purple-500 to-pink-500"
          >
            <FacebookIcon fill="#C94ADD" />
          </Socials>

          <Socials
            href="https://www.instagram.com/hola.sazu/"
            aria-label="Instagram"
            class="transition-transform hover:scale-110 p-2.5 rounded-full bg-gradient-to-br from-purple-500 to-pink-500"
          >
            <InstagramIcon fill="#ffffff" />
          </Socials>
        </div>
      </div>
    </div>

    <!-- DERECHA: formulario -->
    <div>
      <div class="bg-white border border-gray-300 rounded-lg shadow-xl p-8">
        <h3 class="text-3xl font-semibold mb-4 text-teal-500">¡Contáctanos!</h3>
        <p class="text-gray-600 mb-6">
          Mandanos un correo, te responderemos lo más pronto posible.
        </p>

        <form class="space-y-6">
          <!-- Nombre / Apellido -->
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
            <input
              type="text"
              placeholder="Nombre"
              class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-300"
            />
            <input
              type="text"
              placeholder="Apellido"
              class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-300"
            />
          </div>

          <!-- Correo -->
          <div class="relative">
            <input
              type="email"
              placeholder="Correo"
              class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-300"
            />
          </div>

          <!-- Texto -->
          <textarea
            rows="5"
            placeholder="Mensaje"
            class="w-full border border-gray-300 rounded-lg px-4 py-3 focus:outline-none focus:ring-2 focus:ring-blue-300"
          ></textarea>

          <!-- Botón -->
          <button
            type="submit"
            class="w-full text-center bg-gradient-to-br from-purple-500 to-pink-500 text-white font-semibold py-3 rounded-lg hover:bg-purple-700 transition">
            Enviar
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Imagen cerca del Footer -->
<div class="relative mt-16 h-80 sm:h-96 md:h-120 lg:h-140">
  <Image
    src={felicidadImg}
    alt="Felicidad sin remordimiento"
    class="w-full h-full object-cover shadow-md"
  />
  <div class="absolute inset-0 flex items-center justify-center px-4">
    <h2 class="text-4xl sm:text-5xl md:text-6xl font-extrabold text-white text-center max-w-4xl mx-auto">
      ¡Felicidad sin Remordimiento!
    </h2>
  </div>
</div>

</section>
