---
import Map from './map.jsx';
---

<section class="w-full bg-[#F8EFE3]">
  <div class="mx-auto max-w-6xl px-4 py-10 md:py-14">
    <h2 class="text-2xl md:text-3xl font-semibold text-[#1d1d1b]">
      Ubicaciones
    </h2>
    <p class="mt-3 text-[#1d1d1b]/80 text-base">
      Nos puedes encontrar en:
    </p>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-[1.5fr_1fr] gap-6 md:gap-8">
      <!-- Columna izquierda: Mapa -->
      <div class="relative rounded-xl overflow-hidden w-full h-[300px] md:h-[450px]">
        <div class="absolute inset-0 bg-gray-300"></div>
        <!-- Aquí se inserta el componente de mapa con client:only -->
        <div class="w-full h-full bg-gray-200 text-center flex items-center justify-center text-[#1d1d1b]/50">
          <Map client:only />
        </div>
      </div>

      <!-- Columna derecha: Selectores de Ubicación -->
      <div class="flex flex-col space-y-6">
        <!-- San José -->
        <div>
          <label for="ubicacion-sj" class="block text-[#1d1d1b] font-semibold">
            San José
          </label>
          <select
            id="ubicacion-sj"
            class="w-full rounded-lg border border-[#D9D5CC] bg-white px-4 py-3 text-[#1d1d1b] focus:outline-none focus:border-[#8C162A] transition"
          >
            <option value="">....</option>
            <!-- Opciones de San José -->
          </select>
        </div>

        <!-- Heredia -->
        <div>
          <label for="ubicacion-hd" class="block text-[#1d1d1b] font-semibold">
            Heredia
          </label>
          <select
            id="ubicacion-hd"
            class="w-full rounded-lg border border-[#D9D5CC] bg-white px-4 py-3 text-[#1d1d1b] focus:outline-none focus:border-[#8C162A] transition"
          >
            <option value="">....</option>
            <!-- Opciones de Heredia -->
          </select>
        </div>

        <!-- Otras ubicaciones -->
        <div>
          <label for="ubicacion-otros" class="block text-[#1d1d1b] font-semibold">
            Otras ubicaciones
          </label>
          <select
            id="ubicacion-otros"
            class="w-full rounded-lg border border-[#D9D5CC] bg-white px-4 py-3 text-[#1d1d1b] focus:outline-none focus:border-[#8C162A] transition"
          >
            <option value="">....</option>
            <!-- Otras opciones -->
          </select>
        </div>
      </div>
    </div>
  </div>
</section>
