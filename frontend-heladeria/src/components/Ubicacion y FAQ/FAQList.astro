<div class="isolate bg-white font-light px-10 py-10 max-w-xl mx-auto -ml-[0.5px]">
  <!-- Título y subtítulo -->
  <h2 class="text-left font-semibold text-black">Preguntas frecuentes</h2>
  <p class="mt-2 text-left text-black">¡Escribe tu correo y pregunta!</p>

  <!-- Formulario -->
  <form action="#" method="POST" class="mt-8">
    <!-- Campo correo -->
    <div class="mb-6">
      <label for="correo" class="block text-sm font-semibold text-black">Correo</label>
      <input id="correo" type="email" name="Correo" autocomplete="email"
        class="mt-1 block w-full rounded-md bg-white px-3.5 py-2 text-base text-gray-900 outline-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:outline-indigo-600" />
    </div>

    <!-- Campo mensaje -->
    <div class="mb-6">
      <label for="message" class="block text-sm font-semibold text-black">Mensaje ejemplo</label>
      <textarea id="message" name="message" rows="4"
        class="mt-1 block w-full rounded-md bg-white px-3.5 py-2 text-base text-black outline-1 outline-gray-300 placeholder:text-gray-400 focus:outline-2 focus:outline-indigo-600"></textarea>
    </div>

    <!-- Botón enviar -->
    <div>
      <button type="submit"
        class="w-full rounded-md bg-purple-400 px-4 py-2 text-white font-semibold hover:bg-purple-500 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-indigo-600">
        Enviar
      </button>
    </div>
  </form>
</div>

<div class="isolate bg-white font-light px-5 py-0 max-w-xs mx-auto text-left ml-170 mt-[-400px]">

    <div class="relative inline-block text-left">
