<section class="w-full bg-[#F8EFE3]">
  <div class="mx-auto max-w-6xl px-4 py-10 md:py-14">
    <h2 class="text-2xl md:text-3xl font-semibold text-[#1d1d1b]">
      Preguntas Frecuentes
    </h2>
    <p class="mt-3 text-[#1d1d1b]/80 text-base">
      ¡Escribe tu correo y tu pregunta!
    </p>

    <div
      class="mt-6 grid grid-cols-1 md:grid-cols-[1fr_auto_1.25fr] gap-6 md:gap-8"
    >
      <!-- Columna izquierda: Form -->
      <form
        id="simpleForm"
        action="https://formsubmit.co/vladros9871@gmail.com"
        method="POST"
        class="rounded-xl"
      >
        <!-- Configuración FormSubmit -->
        <input type="hidden" name="_subject" value="🍦 Pregunta frecuente" />
        <input type="hidden" name="_captcha" value="false" />
        <input type="hidden" name="_template" value="basic" />

        <div class="space-y-4">
          <input
            type="email"
            name="correo"
            placeholder="ejemplo@gmail.com"
            required
            pattern="^[a-zA-Z0-9._%+-]+@(gmail\.com|yahoo\.com|outlook\.com)$"
            title="Ingresa un correo válido de Gmail, Yahoo o Outlook"
            class="w-full rounded-lg border border-[#D9D5CC] bg-white px-4 py-3 text-[#1d1d1b] placeholder-[#9AA09A] outline-none focus:border-[#8C162A] transition"
          />
          <textarea
            name="mensaje"
            rows="7"
            required
            minlength="10"
            placeholder="Texto ejemplo"
            class="w-full rounded-lg border border-[#D9D5CC] bg-white px-4 py-3 text-[#1d1d1b] placeholder-[#9AA09A] outline-none focus:border-[#8C162A] transition resize-none"
          ></textarea>

          <button
            type="submit"
            class="w-full rounded-lg bg-[#E9E3DA] px-4 py-3 text-[#1d1d1b] font-semibold hover:bg-[#e3dccf] transition"
          >
            Enviar
          </button>

          <!-- ✅ Mensaje de confirmación -->
          <p
            id="simpleMsg"
            class="hidden text-green-600 text-sm font-medium mt-2"
          >
            ✅ Gracias por tu mensaje. Te responderemos pronto.
          </p>
        </div>
      </form>

      <!-- Separador vertical -->
      <div class="hidden md:block w-px bg-[#D9D5CC] mx-auto" aria-hidden="true">
      </div>

      <!-- Columna derecha: FAQs -->
      <div class="flex flex-col">
        <div class="space-y-4">
          <!-- Ítem 1 -->
          <details class="group">
            <summary
              class="list-none flex items-center justify-between rounded-lg border border-[#D9D5CC] bg-white px-4 py-3 text-[#1d1d1b] cursor-pointer"
            >
              <span class="tracking-wide">¿.................?</span>
              <svg
                class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180 text-[#1d1d1b]"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z"
                  clip-rule="evenodd"></path>
              </svg>
            </summary>
            <div class="px-4 pt-3 pb-4 text-[#1d1d1b]/80">
              Aquí va la respuesta a la pregunta frecuente.
            </div>
          </details>

          <!-- Ítem 2 -->
          <details class="group">
            <summary
              class="list-none flex items-center justify-between rounded-lg border border-[#D9D5CC] bg-white px-4 py-3 text-[#1d1d1b] cursor-pointer"
            >
              <span class="tracking-wide">¿.................?</span>
              <svg
                class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180 text-[#1d1d1b]"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z"
                  clip-rule="evenodd"></path>
              </svg>
            </summary>
            <div class="px-4 pt-3 pb-4 text-[#1d1d1b]/80">
              Respuesta ejemplo.
            </div>
          </details>

          <!-- Ítem 3 -->
          <details class="group">
            <summary
              class="list-none flex items-center justify-between rounded-lg border border-[#D9D5CC] bg-white px-4 py-3 text-[#1d1d1b] cursor-pointer"
            >
              <span class="tracking-wide">¿.................?</span>
              <svg
                class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180 text-[#1d1d1b]"
                viewBox="0 0 20 20"
                fill="currentColor"
                aria-hidden="true"
              >
                <path
                  fill-rule="evenodd"
                  d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z"
                  clip-rule="evenodd"></path>
