<section class="w-full bg-gradient-to-r from-gray-50 to-stone-200">
  <div class="mx-auto max-w-6xl px-4 py-10 md:py-14">
    <h2 class="text-2xl md:text-3xl font-extrabold text-teal-500">
      Preguntas Frecuentes
    </h2>
    <p class="mt-3 text-gray-700 text-base">
      ¡Escribe tu correo y tu pregunta!
    </p>

    <div class="mt-6 grid grid-cols-1 md:grid-cols-[1fr_auto_1.25fr] gap-6 md:gap-8">
      <!-- Columna izquierda: Formulario -->
      <form class="rounded-xl">
        <div class="space-y-4">
          <input
            type="email"
            placeholder="ejemplo@gmail.com"
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-800 placeholder-gray-400 outline-none focus:ring-2 focus:ring-blue-300 transition"
          />
          <textarea
            rows={7}
            placeholder="Texto ejemplo"
            class="w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-800 placeholder-gray-400 outline-none focus:ring-2 focus:ring-blue-300 transition resize-none"
          ></textarea>

          <button
            type="submit"
            class="w-full rounded-lg bg-gradient-to-br from-purple-500 to-pink-500 px-4 py-3 text-white font-semibold hover:opacity-95 transition"
          >
            Enviar
          </button>
        </div>
      </form>

      <!-- Separador vertical -->
      <div class="hidden md:block w-px bg-gray-300 mx-auto" aria-hidden="true"></div>

      <!-- Columna derecha: FAQs -->
      <div class="flex flex-col">
        <div class="space-y-4">
          <!-- Ítem 1 -->
          <details class="group">
            <summary
              class="list-none flex items-center justify-between rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-800 cursor-pointer"
            >
              <span class="tracking-wide">¿.................?</span>
              <svg
                class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180 text-gray-800"
                viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="px-4 pt-3 pb-4 text-gray-700">
              Aquí va la respuesta a la pregunta frecuente.
            </div>
          </details>

          <!-- Ítem 2 -->
          <details class="group">
            <summary
              class="list-none flex items-center justify-between rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-800 cursor-pointer"
            >
              <span class="tracking-wide">¿.................?</span>
              <svg
                class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180 text-gray-800"
                viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="px-4 pt-3 pb-4 text-gray-700">
              Respuesta ejemplo.
            </div>
          </details>

          <!-- Ítem 3 -->
          <details class="group">
            <summary
              class="list-none flex items-center justify-between rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-800 cursor-pointer"
            >
              <span class="tracking-wide">¿.................?</span>
              <svg
                class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180 text-gray-800"
                viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="px-4 pt-3 pb-4 text-gray-700">
              Respuesta ejemplo.
            </div>
          </details>

          <!-- Ítem 4 -->
          <details class="group">
            <summary
              class="list-none flex items-center justify-between rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-800 cursor-pointer"
            >
              <span class="tracking-wide">¿..................?</span>
              <svg
                class="h-5 w-5 shrink-0 transition-transform group-open:rotate-180 text-gray-800"
                viewBox="0 0 20 20" fill="currentColor" aria-hidden="true"
              >
                <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 10.94l3.71-3.71a.75.75 0 111.06 1.06l-4.24 4.24a.75.75 0 01-1.06 0L5.21 8.29a.75.75 0 01.02-1.08z" clip-rule="evenodd" />
              </svg>
            </summary>
            <div class="px-4 pt-3 pb-4 text-gray-700">
              Respuesta ejemplo.
            </div>
          </details>
        </div>

        <!--
        <button
          type="button"
          class="mt-6 w-full rounded-lg border border-gray-300 bg-white px-4 py-3 text-gray-800 font-semibold hover:bg-gray-50 transition"
        >
          Ver más preguntas frecuentes
        </button> -->
      </div>
    </div>
  </div>
</section>
