---
import { Image } from "astro:assets";
import fondo from "../../assets/Material-para-Bright-15.jpg";
---

<section
  class="w-full mx-auto h-[600px] flex items-center justify-between ml-12 px-16"
>
  <!-- Fondo decorativo -->
  <div
    class="absolute inset-0 w-full h-170 -z-10 bg-gradient-to-r from-sky-200 to-blue-300"
  >
  </div>

  <!-- Bloque de texto principal -->
  <div class="w-1/2 text-black space-y-6 z-10 mb-24">
    <h2 class="text-5xl font-extrabold">Sobre nosotros</h2>
    <p class="text-xl leading-relaxed">
      Lorem ipsum dolor sit amet, consectetur adipiscing elit, sed eiusmod
      tempor incididunt ut labore et dolore magna aliqua. Ut enim ad minim
      veniam, quis nostrud exercitation ullamco laboris nisi ut aliquip ex ea
      commodo consequat.
    </p>
  </div>
</section>
