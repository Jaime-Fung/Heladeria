---
import FacebookIcon from "../Icons/FacebookIcon.astro";
import InstagramIcon from "../Icons/InstagramIcon.astro";
import WhatsappIcon from "../Icons/WhatsappIcon.astro";
import LogoSrc from "../../assets/logo-sazu.png";
---

<header class="bg-transparent sticky top-5 z-50 font-normal">
  <nav
    class="max-w-7xl mx-auto flex items-center justify-between gap-4 px-6 py-1 rounded-2xl shadow-md border border-gray-100 bg-white backdrop-blur-lg"
  >
    <!-- Logo y nombre -->
    <a
      href="/"
      class="flex items-center gap-2 text-2xl font-bold text-purple-600"
    >
      <img src={LogoSrc.src} alt="Logo Sazú" class="w-17 h-17 object-contain" />
      <span class="font-display tracking-wide">Sazú</span>
    </a>

    <!-- Menú principal -->
    <ul
      class="hidden lg:flex items-center gap-6 text-base font-medium text-gray-700"
    >
      <li>
        <a href="#" class="hover:text-purple-600 transition">Sobre Nosotros</a>
      </li>
      <li><a href="/#catalogo" class="hover:text-purple-600 transition">Catálogo</a></li>
      <li>
        <a href="#" class="hover:text-purple-600 transition">Cuestionario</a>
      </li>
      <li>
        <a href="#" class="hover:text-purple-600 transition">Ubicaciones</a>
      </li>
      <li>
        <a href="#" class="hover:text-purple-600 transition"
          >Preguntas Frecuentes</a
        >
      </li>
      <li><a href="#" class="hover:text-purple-600 transition">Contacto</a></li>
    </ul>

    <!-- Redes sociales -->
    <div class="hidden lg:flex gap-4">
      <WhatsappIcon />
      <InstagramIcon />
      <FacebookIcon />
    </div>

    <!-- Menú móvil -->
    <div class="lg:hidden">
      <button
        id="menu-toggle"
        class="text-gray-700 p-2 rounded-md hover:bg-gray-100 focus:outline-none focus:ring-2 focus:ring-purple-300"
      >
        <svg class="w-6 h-6" fill="none" viewBox="0 0 24 24" stroke="currentColor">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>

      <div
        id="mobile-menu"
        class="hidden absolute top-full inset-x-0 mt-2 w-full bg-white rounded-lg shadow-lg z-50"
      >
        <!-- Enlaces -->
        <ul class="flex flex-col p-4 space-y-2 text-gray-700 font-medium">
          <li><a href="#" class="block hover:text-purple-600">Sobre Nosotros</a></li>
          <li><a href="/#catalogo" class="block hover:text-purple-600">Catálogo</a></li>
          <li><a href="#" class="block hover:text-purple-600">Cuestionario</a></li>
          <li><a href="#" class="block hover:text-purple-600">Ubicaciones</a></li>
          <li><a href="#" class="block hover:text-purple-600">Preguntas Frecuentes</a></li>
          <li><a href="#" class="block hover:text-purple-600">Contacto</a></li>
        </ul>
        <!-- Redes sociales -->
        <div class="flex items-center justify-around p-4 border-t border-gray-200">
          <WhatsappIcon />
          <InstagramIcon />
          <FacebookIcon /> 
        </div>
      </div>
    </div>
  </nav>

  <script>
    document.addEventListener("DOMContentLoaded", () => {
  const btn = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");

  if (btn && menu) {
    btn.addEventListener("click", () => menu.classList.toggle("hidden"));
  }
});
  </script>
  </nav>
</header>