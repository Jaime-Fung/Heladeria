---
---

<footer class="bg-gray-100 text-gray-800">
  <!-- Contenedor principal -->
  <div class="max-w-7xl mx-auto py-8 px-6 sm:px-6 lg:px-8">
    <!-- Logo y Nombre -->
    <div class="flex items-center justify-between">
      <div class="flex items-center">
        <img src="../../assets/logo-sazu.png" alt="Sazú Logo" class="h-12 w-auto mr-2" />
        <span class="text-3xl font-bold">Sazú</span>
      </div>

      <!-- Menú -->
      <div class="space-x-8 text-sm">
        <a href="/sobre-nosotros" class="hover:text-blue-600">Sobre Nosotros</a>
        <a href="/catalogo" class="hover:text-blue-600">Catálogo</a>
        <a href="/cuestionario" class="hover:text-blue-600">Cuestionario</a>
        <a href="/faqs" class="hover:text-blue-600">FAQs</a>
        <a href="/contacto" class="hover:text-blue-600">Contacto</a>
      </div>

      <!-- Redes Sociales -->
      <div class="flex space-x-4 text-xl">
        <a href="https://wa.me/" class="hover:text-green-600">
          <i class="fab fa-whatsapp"></i>
        </a>
        <a href="https://facebook.com" class="hover:text-blue-600">
          <i class="fab fa-facebook"></i>
        </a>
        <a href="https://instagram.com" class="hover:text-pink-600">
          <i class="fab fa-instagram"></i>
        </a>
      </div>
    </div>

    <!-- Línea horizontal y copyright -->
    <div class="border-t border-gray-300 py-4 text-center mt-8">
      <p class="text-sm">&copy; 2025 Sazú. Todos los derechos reservados.</p>
    </div>
  </div>

</footer>
