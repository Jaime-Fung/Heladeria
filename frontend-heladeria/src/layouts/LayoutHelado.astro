---
import NavBar from "../components/General/NavBar.astro";
import Footer from "../components/General/Footer.astro";
import { ClientRouter } from "astro:transitions";
const { bgClass = "" } = Astro.props;
---

<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/png" href="/Logo-Sazú.png" />
    <meta name="generator" content="Astro" />
    <title>SAZÚ</title>
    <ClientRouter />

    <script>
      document.documentElement.classList.add("loading");
      document.fonts.ready.then(() => {
        document.documentElement.classList.remove("loading");
      });
    </script>

    
    
    <script
    type ="text/partytown"
     async
      src="https://www.googletagmanager.com/gtag/js?id=G-CM67QTFB33"
    ></script>
    <script type="text/partytown">
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "G-CM67QTFB33");
    </script>
    

  </head>
  <body class={bgClass}>
    
    <NavBar />
    
    <slot />
  </body>
</html>

<style>
  html,
  body {
    font-family: "Graviola Soft Regular";
    margin: 0;
    width: 100%;
    height: 100%;
    overflow-x: hidden;
  }
  html {
    overflow-y: scroll;
  }
  
  
</style>
